{
  "name": "pingx969",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Resume Optimizer + Job Application Autofiller (web dashboard, API, Chrome MV3 extension)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @pingx969/api\" \"npm run dev -w @pingx969/web\"",
    "build": "npm run build -w @pingx969/web && npm run build -w @pingx969/api && npm run build -w @pingx969/extension",
    "start": "npm run start -w @pingx969/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run typecheck && npm run lint && npm run test:coverage && npm run test:e2e",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx apps/api/src/cli.ts migrate",
    "db:seed": "tsx apps/api/src/cli.ts seed",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "e2e:install": "playwright install chromium",
    "mock-site": "tsx scripts/mock-site.ts",
    "package:extension": "node scripts/package-extension.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "jszip": "^3.10.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.3"
  }
}
