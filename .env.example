# PINGx969 configuration. Copy to .env and adjust. All values are optional in development.

# --- Server
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
# Where the dashboard is served from (empty = same origin as the API; dev default http://localhost:5173)
# WEB_URL=
# Origins allowed to make cookie-authenticated, state-changing requests (comma-separated)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000
# COOKIE_SECURE=true            # defaults to true in production (requires HTTPS)

# --- Data
# Leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite) stored in DATA_DIR.
# DATABASE_URL=postgres://user:password@localhost:5432/pingx969
DATA_DIR=./data
# STORAGE_DIR=./data/objects    # encrypted uploaded files

# --- Encryption (REQUIRED in production). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In development a key is generated into DATA_DIR/dev-encryption.key if unset.
APP_ENCRYPTION_KEY=

# --- Sessions
SESSION_TTL_DAYS=14
EXTENSION_TOKEN_TTL_DAYS=30

# --- AI provider: "heuristic" (built-in, private, default) or "anthropic"
AI_PROVIDER=heuristic
# Server-side only — never put this in the extension or the web app.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
AI_TIMEOUT_MS=90000

# --- Job URL import. Keep false in production (blocks private-network SSRF).
ALLOW_PRIVATE_URL_FETCH=false

# --- Rate limits (requests per minute)
RATE_LIMIT_AUTH=20
RATE_LIMIT_API=600
RATE_LIMIT_HEAVY=60
